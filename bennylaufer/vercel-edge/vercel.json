{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/pini8151gz/pini8151gz@8d2b9453efa06b110799da7db7529743f59f6006/bennylaufer/site/assets/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/pini8151gz/pini8151gz@8d2b9453efa06b110799da7db7529743f59f6006/bennylaufer/site/media/:path*"
    },
    {
      "source": "/:file(favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|icon-512\\.png|og\\.jpg|robots\\.txt|sitemap\\.xml)",
      "destination": "https://cdn.jsdelivr.net/gh/pini8151gz/pini8151gz@8d2b9453efa06b110799da7db7529743f59f6006/bennylaufer/site/:file"
    }
  ],
  "headers": [
    {
      "source": "/(assets|media)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
