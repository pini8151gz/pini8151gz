# העתק לקובץ .env ומלא את הערכים (הקובץ .env לא נכנס ל-git)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# מחרוזת אקראית ארוכה. ליצירה:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# אופציונלי: כתובת ה-callback המדויקת. אם ריק – נגזרת מהכתובת שבה ניגשים לשרת
OAUTH_REDIRECT_URI=
# אופציונלי: כמה קבצים להעביר במקביל (ברירת מחדל 6)
MAX_WORKERS=6
